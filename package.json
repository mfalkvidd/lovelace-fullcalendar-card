{
  "name": "lovelace-fullcalendar-card",
  "private": true,
  "version": "0.1.0",
  "description": "A Home Assistant calendar card for family dashboards",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "test": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "engines": { "node": ">=22" },
  "repository": {
    "type": "git",
    "url": "https://github.com/gadgetchnnel/lovelace-fullcalendar-card"
  },
  "author": "Steven Rollason",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "fullcalendar": "7.1.0",
    "lit": "3.3.3",
    "temporal-polyfill": "1.0.1",
    "weekstart": "2.0.0"
  }
}
